# STM32 USB CDC (app) + ROM DFU — not board-serial-specific.
# Install:
#   sudo cp scripts/udev/99-stm32-dfu.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=usb --action=add
# Then unplug/replug once (or re-enter DFU).
#
# ATTRS walks the USB parent chain (more reliable than ATTR on Jetson).
# TAG+=uaccess grants the active seat session access without MODE=0666.

ACTION=="add|change", SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0666", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0666", TAG+="uaccess"
