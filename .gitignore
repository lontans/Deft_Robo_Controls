# CubeIDE / Eclipse build output
Debug/*
!Debug/DeftRoboticsControlsPCB.elf
Release/

# IDE metadata
.settings/
.metadata/
*.launch

# Optional: OS junk
Thumbs.db
Desktop.ini
docs/damiao-bringup.md

# Python bytecode / caches (never commit; untrack if already staged:
#   git rm -r --cached '**/__pycache__' 2>/dev/null; git rm -r --cached '*.pyc' 2>/dev/null)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/
scripts/.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# deft_controls_sdk live telemetry mirror
.deft_session/
scripts/.deft_session/

# Bench / agent run logs (keep the .py helpers)
scripts/_tmp_*_run.log
scripts/_tmp_*.log

# Root / agent scratch — never commit dumps or recovery trees
/*.csv
/tmp_*.txt
/RTOS_BRINGUP_HANDOFF.txt
.tmp_recover/

# Dated agent handoffs (durable notes live in bringup/lessons/bench docs)
docs/handoff-*.md

# Vendor GUI apps (not documentation) — keep PDFs/source samples only
External_Documentation/RobStride/motor_toolV14L/
