# CubeIDE / Eclipse build output
Debug/*
!Debug/DeftRoboticsControlsPCB.elf
Release/

# IDE metadata
.settings/
.metadata/
*.launch

# Optional: OS junk
Thumbs.db
Desktop.ini
docs/damiao-bringup.md

# Python bytecode / caches (never commit; untrack if already staged:
#   git rm -r --cached '**/__pycache__' 2>/dev/null; git rm -r --cached '*.pyc' 2>/dev/null)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/
scripts/.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# deft_controls_sdk live telemetry mirror
.deft_session/
scripts/.deft_session/

# Bench / agent run logs and dump text (keep useful .py helpers only under legacy/)
scripts/_tmp_*_run.log
scripts/_tmp_*.log
scripts/_tmp_*.txt
scripts/_tmp_*.py
scripts/legacy/_tmp_*.log
scripts/legacy/_tmp_*.txt
scripts/legacy/_tmp_*_run.log

# Local agent / IDE scratch (not product source)
.claude/
.cursor/

# Root / agent scratch — never commit dumps or recovery trees
/*.csv
/tmp_*.txt
/RTOS_BRINGUP_HANDOFF.txt
.tmp_recover/

# Dated agent handoffs (durable notes live in bringup/lessons/bench docs)
docs/handoff-*.md

# Vendor docs: keep stub README tracked; ignore bulk PDFs/EDS/SDK trees
External_Documentation/**
!External_Documentation/README.md

# Working checkout of gitlab deft_vbeta — own .git, not this repo's source.
/deft_vbeta/
